# Large binaries live on Hugging Face, not in git
*.npy
*.pth
*.pt
*.ckpt
*.zip
*.tar.gz
__pycache__/
*.py[cod]

# Exception: the nine small per-utterance operational-IoU arrays (3.5 MB) are tracked,
# because c11 and f2 read them and no script in this repo regenerates them.
!data/iou_dist_*.npy
# ...but the localization-conditional arrays are regenerated by
# compute_cross_domain_localization_iou.py, so they stay untracked.
data/iou_dist_*_localization.npy

# Files that arrive with the Hugging Face download, and regenerated figures
data/.cache/
data/.gitattributes
data/README.md
data/SHA256SUMS.txt
code/figures/
